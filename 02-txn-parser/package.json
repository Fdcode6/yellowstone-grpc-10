{
  "name": "solana-wallet-analyzer",
  "version": "1.0.0",
  "description": "Solana钱包分析工具",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "collector": "ts-node src/collector.ts",
    "scorer": "ts-node src/scorer.ts",
    "dashboard": "ts-node src/dashboard.ts",
    "start": "concurrently \"npm run collector\" \"npm run scorer\" \"npm run dashboard\""
  },
  "keywords": [
    "solana",
    "blockchain",
    "wallet",
    "analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@triton-one/yellowstone-grpc": "^1.3.0",
    "axios": "^1.6.2",
    "bs58": "^5.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "sqlite": "^5.0.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
} 